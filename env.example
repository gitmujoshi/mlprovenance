# Blockchain Configuration
# Copy this file to .env and fill in your actual private keys
# NEVER commit the .env file to version control

# Ethereum private key (without 0x prefix)
ETH_PRIVATE_KEY=your_ethereum_private_key_here

# Bitcoin private key (WIF format)
BTC_PRIVATE_KEY=your_bitcoin_private_key_here

# Optional: Override RPC URLs
# ETH_RPC_URL=http://127.0.0.1:8545
# BTC_RPC_URL=http://localhost:8332

# Optional: IPFS configuration
# IPFS_URL=http://localhost:5001 